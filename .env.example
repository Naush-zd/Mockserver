# Copy to .env and fill in. .env is gitignored.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4010

# ─── Microcks (local instance you run yourself) ──────────────────────────────
# Point this at your locally-run Microcks (e.g. the `microcks` container in
# docker-compose, or a standalone container). There is no hosted Microcks.
MICROCKS_URL=http://localhost:8585
# Optional Keycloak client-credentials auth — only needed if your LOCAL Microcks
# is itself secured. Leave blank for the default local Microcks (no auth).
MICROCKS_KEYCLOAK_TOKEN_URL=
MICROCKS_CLIENT_ID=
MICROCKS_CLIENT_SECRET=
MICROCKS_SERVICE_PREFIX=unified-

# ─── State persistence ────────────────────────────────────────────────────────
# S3 persistence (preferred for ECS). Set S3_STATE_BUCKET and the server will
# read/write workspace state to S3 — survives container restarts, no EFS needed.
# The ECS task role must have s3:GetObject + s3:PutObject on this bucket/key.
S3_STATE_BUCKET=
S3_STATE_KEY=unified-mockserver/state.json
S3_STATE_REGION=us-east-1

# File-based fallback. Used when S3 is not configured. On ECS this only works
# if /app/artifacts is backed by EFS; otherwise data is lost on task restart.
# STATE_FILE_PATH=/data/state.json

# ─── Dashboard auth (Okta SAML) ──────────────────────────────────────────────
# Leave AUTH_ENABLED=false until Okta admin returns the IdP metadata URL (or
# the manual SSO URL + signing cert). When enabled, browsers are redirected
# to Okta over SAML; CI / mobile / automation send X-API-Key instead.
AUTH_ENABLED=false

# Identifier we send the IdP as our SP. Must match the "Audience URI / SP Entity
# ID" configured on the SAML app.
SAML_ENTITY_ID=unified-mockserver

# Where the IdP POSTs the SAML response — must match the ACS URL registered on
# the SAML app.
#   Local dev:  http://localhost:4010/auth/saml/callback
#   Prod (DNS): https://your-domain.example.com/auth/saml/callback
SAML_CALLBACK_URL=http://localhost:4010/auth/saml/callback

# Easiest path: paste the metadata URL Okta admin gives you. The app fetches
# it on first login and extracts entryPoint / cert / issuer automatically.
SAML_IDP_METADATA_URL=

# Manual fallback — only needed if Okta doesn't expose a metadata URL. Set
# SAML_IDP_SSO_URL and SAML_IDP_CERT (PEM, single line or multi-line both ok).
# SAML_IDP_ENTITY_ID is optional but tightens issuer matching when set.
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_CERT=

# Name of the SAML attribute that holds group memberships. Okta typically
# sends `groups` when a Group Attribute Statement is configured on the SAML
# app. Some IdPs use `memberOf`. Leave default unless told otherwise.
SAML_GROUP_ATTRIBUTE=groups

# 64+ random hex chars. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Static key for service-to-service callers (CI runners, mobile apps,
# monitoring). Generate with: openssl rand -hex 32. Rotate by changing this
# value and redeploying.
MOCK_API_KEY=

# Optional comma-separated IdP group names. When set, only members of at
# least one of these groups can log in. Leave empty to allow any user
# assigned to the SAML app.
# Example: AUTH_ALLOWED_GROUPS=engineering,qa
AUTH_ALLOWED_GROUPS=

# ─── AI (optional) ───────────────────────────────────────────────────────────
# GROQ_API_KEY=
